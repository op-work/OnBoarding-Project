# Azure Database for PostgreSQL Configuration
DB_HOST=your-server-name.postgres.database.azure.com
DB_PORT=5432
DB_NAME=employee360
DB_USER=app_user
DB_PASSWORD=your_secure_db_password
DB_SSL_MODE=require

# Full Database URL (Optional override if using Azure App Service Connection Strings)
# DATABASE_URL=postgresql+psycopg2://app_user:your_secure_db_password@your-server-name.postgres.database.azure.com:5432/employee360?sslmode=require

# Application JWT Security Secret
JWT_SECRET=your_super_secret_jwt_key_min_32_chars_long
